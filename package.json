{
  "name": "ceviche-presentation",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "install:apps": "npm install --prefix apps/admin && npm install --prefix apps/caja && npm install --prefix apps/cocina && npm install --prefix apps/meseros && npm install --prefix apps/portal",
    "clean:modules": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-modules.ps1",
    "clean:install": "npm run clean:modules && npm install && npm run install:apps",
    "dev:admin": "npm --prefix apps/admin run dev",
    "dev:caja": "npm --prefix apps/caja run dev",
    "dev:cocina": "npm --prefix apps/cocina run dev",
    "dev:meseros": "npm --prefix apps/meseros run dev",
    "dev:portal": "npm --prefix apps/portal run dev",
    "dev:all": "concurrently --names \"admin,caja,cocina,meseros,portal\" -c \"blue,yellow,green,magenta,cyan\" \"npm run dev:admin\" \"npm run dev:caja\" \"npm run dev:cocina\" \"npm run dev:meseros\" \"npm run dev:portal\"",
    "dev": "npm run dev:caja",
    "build:admin": "npm --prefix apps/admin run build",
    "build:caja": "npm --prefix apps/caja run build",
    "build:cocina": "npm --prefix apps/cocina run build",
    "build:meseros": "npm --prefix apps/meseros run build",
    "build:portal": "npm --prefix apps/portal run build",
    "build": "npm run build:caja && npm run build:cocina && npm run build:meseros && npm run build:admin && npm run build:portal",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.jsx",
    "seed:promociones": "node scripts/seed-promociones.js",
    "seed:mesas": "node scripts/seed-mesas.mjs",
    "seed:dashboard-ventas": "node scripts/seed-dashboard-ventas.mjs",
    "seed:reporte-inventario": "node scripts/seed-reporte-inventario.mjs",
    "seed:reporte-cocina": "node scripts/seed-reporte-cocina.mjs"
  },
  "dependencies": {
    "@heroicons/react": "^2.0.18",
    "firebase": "^12.8.0",
    "firebase-admin": "^13.6.0",
    "framer-motion": "^12.27.5",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "react": "18.3.0",
    "react-dom": "18.3.0",
    "react-image-crop": "^11.0.10",
    "react-router-dom": "^6.14.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.12",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "concurrently": "^10.0.3",
    "daisyui": "^4.0.0",
    "gh-pages": "^5.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.0",
    "vite": "^5.2.1"
  }
}
